{
  "expo": {
    "name": "Swipet",
    "slug": "swipet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "swipet",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0956A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.swipet.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#F0956A"
      },
      "package": "com.swipet.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E27289"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Swipet möchte deinen Standort nutzen, um Tiere in deiner Nähe zu finden."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Swipet möchte auf deine Fotos zugreifen."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
